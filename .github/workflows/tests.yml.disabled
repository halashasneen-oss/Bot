name: Paper bot tests
on:
  push:
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
      - run: python -m pip install -r requirements-dev.txt
      - run: python -m pytest -q
      - run: python -m pairbot replay examples/synthetic.jsonl --out runs/ci-replay
      - uses: actions/upload-artifact@v4
        with:
          name: synthetic-test-report-NOT-LIVE
          path: runs/ci-replay/
          retention-days: 3
