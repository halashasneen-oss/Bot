name: Frozen momentum v1 PAPER until Oct6 08 AM Amman
on:
  push:
    branches: [paper-momentum-v1-20261006]
    paths: [.github/workflows/momentum-until-0800.yml]
permissions:
  contents: read
concurrency:
  group: frozen-momentum-v1-until-0800-20261006
  cancel-in-progress: false
jobs:
  first-segment:
    runs-on: ubuntu-latest
    timeout-minutes: 360
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Install pinned public-data dependencies
        run: |
          python -m pip install --only-binary=:all: -r requirements-dev.txt
      - name: Verify full regression and frozen momentum tests
        run: python -m pytest -q
      - name: PAPER segment until 07 AM Amman
        run: python -u -m pairbot.momentum --config config.yaml --output runs/momentum-first --stop-at 2026-10-06T07:00:00+03:00
      - name: Preserve first segment and handoff state
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: momentum-v1-first-${{ github.run_id }}
          path: runs/momentum-first/
          retention-days: 90
          if-no-files-found: error
  final-segment:
    needs: first-segment
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Install identical pinned dependencies
        run: |
          python -m pip install --only-binary=:all: -r requirements-dev.txt
      - uses: actions/download-artifact@v4
        with:
          name: momentum-v1-first-${{ github.run_id }}
          path: runs/momentum-previous
      - name: Resume same bankroll and risk state until 08 AM Amman
        run: python -u -m pairbot.momentum --config config.yaml --resume-from runs/momentum-previous --output runs/momentum-final --stop-at 2026-10-06T08:00:00+03:00
      - name: Preserve final cumulative CSV and complete evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: momentum-v1-final-${{ github.run_id }}
          path: |
            runs/momentum-final/
            runs/momentum-previous/
            config.yaml
            docs/momentum/README_AR.md
          retention-days: 90
          if-no-files-found: error
