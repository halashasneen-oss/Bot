name: Bounded directional public readiness
on:
  push:
    branches: [paper-btc-directional-20261004]
    paths:
      - .github/workflows/directional-readiness.yml
      - pairbot/ntp_probe.py
      - pairbot/directional_readiness.py
permissions:
  contents: read
jobs:
  probe:
    runs-on: ubuntu-latest
    timeout-minutes: 3
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: |
          python -m pip install --only-binary=:all: -r requirements.txt
      - name: Public readiness only, no prediction or execution
        run: python -m pairbot.directional_readiness --output runs/directional-readiness/result.json
      - uses: actions/upload-artifact@v4
        with:
          name: directional-readiness-NOT-PROFIT
          path: runs/directional-readiness/result.json
          retention-days: 7
