name: BTC live PAPER until Oct6 01 AM Amman
on:
  push:
    branches: [paper-until-0100-20261006]
    paths: [.github/workflows/until-0100-paper.yml]
permissions:
  contents: read
concurrency:
  group: btc-until-0100-20261006-single-experiment
  cancel-in-progress: false
jobs:
  verify-and-paper:
    runs-on: ubuntu-latest
    timeout-minutes: 225
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Install own pinned dependencies
        run: |
          python -m pip install --only-binary=:all: -r requirements-dev.txt
      - name: Verify all tests including fixed deadline
        run: python -m pytest -q
      - name: PAPER until Oct6 01 AM Asia Amman no real trades
        run: python -u -m pairbot.until_0100_paper
      - name: Preserve evidence even on failure
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: btc-until-0100-paper-${{ github.run_id }}
          path: |
            runs/unified-until-0100/
            docs/unified/until-0100-plan.json
            docs/unified/policy.json
            docs/unified/transport-policy.json
            docs/unified/UNTIL_0100_AR.md
          retention-days: 90
          if-no-files-found: error
