name: Daily public feature source availability
on:
  push:
    branches: [paper-btc-directional-20261004]
    paths: [.github/workflows/daily-source.yml, pairbot/daily_source_probe.py]
permissions:
  contents: read
jobs:
  probe:
    runs-on: ubuntu-latest
    timeout-minutes: 3
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: |
          python -m pip install --only-binary=:all: -r requirements.txt
      - run: python -m pairbot.daily_source_probe
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: Coinbase-feature-source-NOT-SETTLEMENT
          path: runs/daily-source/result.json
          retention-days: 7
