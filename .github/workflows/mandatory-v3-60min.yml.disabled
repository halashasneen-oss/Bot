name: Mandatory v3 FINAL PAPER 60 minute run
on:
  push:
    branches: [paper-mandatory-v3-final-20261006]
    paths: [.github/workflows/mandatory-v3-60min.yml]
permissions:
  contents: read
concurrency:
  group: mandatory-v3-final-paper-60min-20261006
  cancel-in-progress: false
jobs:
  paper-60min:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Install pinned dependencies
        run: |
          python -m pip install --only-binary=:all: -r requirements-dev.txt
      - name: Run Mandatory v3 FINAL PAPER for 60 active minutes
        run: PYTHONPATH=. python -u scripts/run_mandatory_v3_60min.py
      - name: Preserve complete evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: mandatory-v3-60min-${{ github.run_id }}
          path: runs/mandatory-v3-60min/
          retention-days: 30
          if-no-files-found: error
