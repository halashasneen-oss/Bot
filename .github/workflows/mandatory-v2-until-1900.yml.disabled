name: Mandatory v2 PAPER until 1900 Amman
on:
  push:
    branches: [paper-mandatory-v2-20261006]
    paths: [.github/workflows/mandatory-v2-until-1900.yml]
permissions:
  contents: read
concurrency:
  group: mandatory-v2-paper-until-1900-20261006
  cancel-in-progress: false
jobs:
  paper-until-1900:
    runs-on: ubuntu-latest
    timeout-minutes: 180
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Install pinned dependencies
        run: |
          python -m pip install --only-binary=:all: -r requirements-dev.txt
      - name: Run Mandatory v2 PAPER until 19:00 Amman
        run: PYTHONPATH=. python -u scripts/run_mandatory_v2_until_1900.py
      - name: Preserve complete evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: mandatory-v2-until-1900-${{ github.run_id }}
          path: runs/mandatory-v2-until-1900/
          retention-days: 30
          if-no-files-found: error
