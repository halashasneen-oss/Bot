name: One live BTC five minute diagnostic
on:
  push:
    branches: [paper-btc-directional-20261004]
    paths: [pairbot/five_minute_live.py, .github/workflows/five-minute-live.yml]
permissions:
  contents: read
jobs:
  capture:
    runs-on: ubuntu-latest
    timeout-minutes: 12
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: |
          python -m pip install --only-binary=:all: -r requirements.txt
      - run: python -m pairbot.five_minute_live
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: BTC-five-minute-live-NOT-PROFIT
          path: runs/five-minute-live/
          retention-days: 14
